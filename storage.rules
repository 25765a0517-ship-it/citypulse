rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
             && request.resource.size < 10 * 1024 * 1024; // Maximum 10MB
    }

    // Citizen Complaint Photographs
    match /complaints/{complaintId}/{allPaths=**} {
      // Authenticated users and officers can view complaint photographs
      allow read: if isAuthenticated();
      // Authenticated citizens can upload photographic evidence
      allow write: if isAuthenticated() && isImageFile();
    }

    // Officer Resolution Evidence Photographs
    match /resolutions/{complaintId}/{allPaths=**} {
      // Authenticated users and reporting citizens can view resolution verification photos
      allow read: if isAuthenticated();
      // Only authenticated field officers can upload resolution photos
      allow write: if isAuthenticated() && isImageFile();
    }
  }
}
