rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isOfficer() {
      return isAuthenticated() && getUserRole() == 'officer';
    }

    // Users Collection
    match /users/{userId} {
      // Citizen/Officer/Admin can read their own profile; Admin can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Citizen can only update their own profile; Cannot elevate their own role
      allow update: if isOwner(userId) 
                    && request.resource.data.role == resource.data.role
                    || isAdmin();
                    
      // Registration creates citizen only
      allow create: if isAuthenticated() 
                    && request.resource.data.role == 'citizen'
                    || isAdmin();
                    
      allow delete: if isAdmin();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      // Authenticated users can read public complaint details
      allow read: if isAuthenticated();

      // Citizen creates complaint with their own citizenId and initial 'submitted' status
      allow create: if isAuthenticated() 
                    && request.resource.data.citizenId == request.auth.uid
                    && request.resource.data.status == 'submitted';

      // Citizen can upvote/support; Officer can update workflow if assigned; Admin can update any
      allow update: if isAdmin() 
                    || (isOfficer() && resource.data.officerId == request.auth.uid 
                        && request.resource.data.citizenId == resource.data.citizenId)
                    || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportCount']));

      allow delete: if isAdmin();
    }

    // Complaint History Collection (Audit Log)
    match /complaint_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only immutable audit trail
    }

    // Departments Collection
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
